# Public origin used for OIDC callbacks. Use the externally reachable HTTPS URL in production.
APP_BASE_URL=http://localhost:8000

# Required when OIDC is enabled. Generate a random value of at least 32 characters and keep it secret.
JWT_SECRET_KEY=

# Optional OpenID Connect provider settings. Set all three values together to enable SSO.
# OIDC_ISSUER must be an absolute HTTP(S) URL without a query string or fragment.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
