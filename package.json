{
    "name": "prospector",
    "version": "1.0.0",
    "engines": {
        "node": ">=22.12"
    },
    "scripts": {
        "dev": "vite",
        "build": "NODE_OPTIONS=--experimental-global-webcrypto vite build",
        "test": "vitest run",
        "test:data": "python3 -m unittest discover -s scripts/tests -p 'test_*.py'",
        "test:backend": "python3 -m unittest discover -s backend/tests -p 'test_*.py'",
        "test:pwa": "node scripts/test_pwa_build.mjs",
        "prepare:pages": "node scripts/prepare_pages_build.mjs",
        "catalog": "python3 scripts/icarus_catalog.py --output public/icarus-game/Data/D_CraftingCatalog.json",
        "preview": "vite preview",
        "update-game-assets": "python3 scripts/scan_assets.py"
    },
    "dependencies": {
        "@vueform/multiselect": "^2.6.11",
        "@vueuse/core": "^12.7.0",
        "@vueuse/integrations": "^12.7.0",
        "debounce": "^2.2.0",
        "fuse.js": "^7.5.0",
        "pinia": "^3.0.4",
        "primeflex": "^3.3.1",
        "vue": "^3.5.42",
        "vue-router": "4.5.0",
        "vue-virtual-scroller": "next"
    },
    "devDependencies": {
        "@emotion/hash": "^0.9.2",
        "@vicons/fa": "^0.13.0",
        "@vicons/utils": "^0.1.4",
        "@vitejs/plugin-vue": "^6.0.8",
        "eslint": "^9.21.0",
        "eslint-plugin-vue": "^9.32.0",
        "naive-ui": "^2.45.3",
        "sass": "^1.103.1",
        "vfonts": "^0.0.3",
        "vite": "^8.2.2",
        "vite-plugin-pwa": "^1.3.0",
        "vitest": "^4.1.11"
    }
}
